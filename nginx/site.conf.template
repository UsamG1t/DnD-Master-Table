# Шаблон конфигурации сайта. При деплое ${DOMAIN} подставляется через envsubst.
# Docker-DNS резолвер: имя backend резолвится в рантайме (контейнер может
# перезапуститься с новым IP).
resolver 127.0.0.11 valid=30s;

# --- HTTP :80 — ACME-челлендж и редирект на HTTPS ---
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # webroot для Let's Encrypt (том certbot-www)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS :443 — фронтенд + API + WebSocket ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;

    # Статика Svelte
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API + WebSocket -> backend:8000. /api срезается (backend без префикса).
    location /api/ {
        set $upstream http://backend:8000;
        proxy_pass $upstream/;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # длинные WS-сессии игры
    }
}
